    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "patch-package": "^8.0.1",
    "typescript": "6.0.3"
  }
}
